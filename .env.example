# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave empty for SQLite; set for PostgreSQL)
DATABASE_URL=
# Or individual PostgreSQL settings:
# POSTGRES_DB=resumematch
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# CORS (comma-separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# LLM (leave LLM_API_KEY empty to use deterministic mock mode)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_RETRIES=3

# Score weights (must sum to ~1.0)
SCORE_WEIGHT_SKILLS=0.55
SCORE_WEIGHT_SEMANTIC=0.45
# Level overrides for experience emphasis (semantic weight multiplier)
SCORE_LEVEL_ETUDIANT_SEMANTIC=0.7
SCORE_LEVEL_JUNIOR_SEMANTIC=1.0
SCORE_LEVEL_CONFIRME_SEMANTIC=1.2
